# OpenAI Configuration (Conversational Reasoning & Complaint Structuring)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Sarvam AI Configuration (Multilingual Speech-to-Text, Text-to-Speech & Document Intelligence)
SARVAM_API_KEY=your_sarvam_api_key_here

# Supabase Configuration (Optional Cloud Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Gemini (optional fallback, used when OpenAI is not configured or fails)
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-3.8-flash

# Supabase server-only secret, used by `npm run create-admin`. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Default admin account created by `npm run create-admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password
